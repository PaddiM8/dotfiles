set $discord teams-for-linux
set $primary_monitor DP-5
set $secondary_monitor eDP-1

gaps inner 5
gaps outer 5

blur enable

bindsym $mod+shift+o exec ~/.scripts/rdp-select
bindsym $mod+shift+t exec ~/projects/scripts/src/pick-ta
bindsym $mod+shift+p exec ~/.local/bin/move-built-files
bindsym $mod+shift+y exec ~/.local/bin/move-built-files debug

exec way-displays
exec jetbrains-toolbox --minimize
