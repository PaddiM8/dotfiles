#!/usr/bin/env elk

killall swaybg | disposeErr

if cat("/etc/hostname") == "ow-laptop" {
    swaybg -i ~/pictures/wallpaper.jpg
} else {
    # swaybg -i ${find ~/pictures/wallpapers/ -type f | shuf -n 10}
    swaybg -i ~/pictures/wallpapers/IMGP4143.jpg
    feh --no-fehbg --bg-fill ${find ~/pictures/wallpapers -type f | shuf -n 1}
}

