#!/usr/bin/env elk

let nameMap = {}
for file in dir::files ~/.local/share/remmina {
    let name = file | split "_" | iter::at(2)
    nameMap[name] = file
}

let choice = nameMap
    | dict::keys
    | rofi -dmenu -p "Choose a VM"

~/.scripts/remove-rdp-black-bar | background
remmina(nameMap[choice])
swaymsg gaps outer current 5
